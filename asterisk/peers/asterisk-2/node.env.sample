# Node-local runtime metadata. Copy to a protected host-local file (for
# example /etc/asterisk/node.env); do not commit production values.
ASTERISK_NODE_ID=2
PUBLIC_IP=<ASTERISK_2_PUBLIC_IP_OR_FQDN>

# FastAPI's single AMI target for this phase. Set this only when Asterisk-2 is
# deliberately selected; it is not a list and does not imply automatic failover.
AMI_HOST=<ASTERISK_2_PRIVATE_IP_OR_FQDN>
AMI_PORT=5038
