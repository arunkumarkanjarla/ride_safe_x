# RideNova local development — copy to `.env` and fill in real values.
# NEVER commit `.env`. NEVER put real passwords in this file.

# Application
RIDENOVA_ENV=development

# PostgreSQL on Windows host (no Postgres container).
# From containers use host.docker.internal; from host processes use localhost.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=ride_safe_x
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_ROTATE_BEFORE_SHARED_USE

# SQLAlchemy URL (psycopg v3). URL-encode special characters in the password.
# Example container URL (password is placeholder only):
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@host.docker.internal:5432/ride_safe_x
# Example host-side URL for local pytest / alembic on Windows:
DATABASE_URL_HOST=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ride_safe_x

# Redis / RabbitMQ (Docker service hostnames on the compose network)
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://ridenova:ridenova@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=ridenova
RABBITMQ_DEFAULT_PASS=ridenova

# Filesystem storage (no MinIO)
# Windows host path mounted into the API container:
#   D:\ridenova-data\uploads  ->  /data/ridenova/uploads
# Linux deployment path: /var/lib/ridenova/uploads
RIDENOVA_STORAGE_PATH=/data/ridenova/uploads

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Auth (Phase 2) — use a long random secret; never commit real values
JWT_SECRET=DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_VALUE_32+
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=300

# Phase 9 payments — sandbox only (never enable in production)
# PAYMENTS_SANDBOX_ENABLED defaults to true when RIDENOVA_ENV != production
PAYMENTS_SANDBOX_ENABLED=true
PAYMENTS_SANDBOX_TOKEN=DEV_ONLY_SANDBOX_PAYMENT_TOKEN_CHANGE_ME

